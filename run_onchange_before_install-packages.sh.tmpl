#!/bin/bash

set -eu

{{ if eq .chezmoi.osRelease.id "ubuntu" "linuxmint" -}}

echo "Detected Mint/Ubuntu system. Updating apt..."
sudo apt-get update

PACKAGES=(
    alacritty
    curl
    eza
    fish
    flatpak
    git
    mpv
    wget
    zoxide
    # neovim related
    neovim
    nodejs
    npm
    python3
    python3-pip
    python3-venv
    fzf
    fd-find
    ripgrep
)

echo "Installing packages with apt..."
sudo apt-get install -y "${PACKAGES[@]}"

{{ else if eq .chezmoi.osRelease.id "cachyos" -}}

echo "Detected CachyOS system..."

PACKAGES=(
    alacritty
    curl
    eza
    fish
    flatpak
    git
    mpv
    wget
    zoxide
    # neovim related
    neovim
    nodejs
    npm
    python
    python-pip
    python-virtualenv
    fzf
    fd
    ripgrep
)

echo "Installing packages with pacman..."
sudo pacman -Syu --noconfirm --needed "${PACKAGES[@]}"

{{ else -}}

echo "Unsupported OS: {{ .chezmoi.osRelease.id }}"
exit 1

{{ end -}}

echo "Installing Flatpak packages"
flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo
flatpak install -y flathub          \
    io.github.flattool.Warehouse    \
    com.github.tchx84.Flatseal      \

echo "Package installation complete!"
